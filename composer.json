{
  "name": "nitsan/ns-basetheme",
  "type": "typo3-cms-extension",
  "description": "The TYPO3 theme which is design for parent and child theme concept, This parent theme have common and global configuration to support the child theme. Read more at documentation.",
  "keywords": [
    "TYPO3 CMS",
    "introduction",
    "Basetheme",
    "bootstrap",
    "responsive",
    "frontend",
    "theme",
    "ns"
  ],
  "homepage": "https://gitlab.com/sanjay_nitsan/ns_basetheme",
  "authors": [
    {
        "name": "Team NITSAN",
        "email": "sanjay@nitsan.in",
        "role": "Developer",
        "homepage": "http://www.nitsan.in/"
    }
  ],
  "support": {
    "issues": "https://gitlab.com/sanjay_nitsan/ns_basetheme/issues"
  },
  "license": "MIT",
  "require": {
    "typo3/cms-core": ">=8.0.0",
    "gridelementsteam/gridelements": ">=8.0.0 || dev-master"
  },
  "autoload": {
    "psr-4": {
      "NITSAN\\ns_basetheme\\": "Classes/"
    }
  },
  "replace": {
      "ns_basetheme": "3.1.5",
      "nitsan/ns-basetheme": "3.1.5"
  },
  "config": {
    "vendor-dir": ".Build/vendor/",
    "bin-dir": ".Build/bin/"
  },
  "extra": {
      "typo3/cms": {
          "cms-package-dir": "{$vendor-dir}/typo3/cms",
          "web-dir": ".Build/public",
          "extension-key": "ns_basetheme"
      }
  }
}