{
  "name": "nitsan/site-default",
  "type": "typo3-cms-extension",
  "description": "Site-default delivers a full configured frontend theme for TYPO3, based on the Bootstrap CSS Framework.",
  "keywords": [
    "TYPO3 CMS",
    "introduction",
    "sitedefault",
    "bootstrap",
    "responsive",
    "frontend",
    "theme",
    "web"
  ],
  "homepage": "https://gitlab.com/sanjay_nitsan/site_default",
  "authors": [
    {
        "name": "Team NITSAN",
        "email": "info@nitsan.in",
        "role": "Developer",
        "homepage": "http://www.nitsan.in/"
    }
  ],
  "support": {
    "issues": "https://gitlab.com/sanjay_nitsan/site_default/issues"
  },
  "license": "MIT",
  "require": {
    "typo3/cms-core": ">=8.0.0",
    "georgringer/news": ">=4.3.0",
    "gridelementsteam/gridelements": ">=8.0.0"
  },
  "autoload": {
    "psr-4": {
      "NITSAN\\site_default\\": "Classes/"
    }
  },
  "replace": {
      "site_default": "self.version",
      "nitsan/site-default": "self.version"
  },
  "config": {
    "vendor-dir": ".Build/vendor/",
    "bin-dir": ".Build/bin/"
  },
  "extra": {
      "typo3/cms": {
          "extension-key": "site_default",
          "web-dir": ".Build/Web",
      }
  }
}