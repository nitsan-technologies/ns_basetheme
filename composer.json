{
  "name": "nitsan/ns-basetheme",
  "type": "typo3-cms-extension",
  "description": "ns-basetheme delivers a full configured frontend theme for TYPO3, based on the Bootstrap CSS Framework.",
  "keywords": [
    "TYPO3 CMS",
    "introduction",
    "nsBasetheme",
    "bootstrap",
    "responsive",
    "frontend",
    "theme",
    "web"
  ],
  "homepage": "https://gitlab.com/sanjay_nitsan/ns_basetheme",
  "authors": [
    {
        "name": "Team NITSAN",
        "email": "info@nitsan.in",
        "role": "Developer",
        "homepage": "http://www.nitsan.in/"
    }
  ],
  "support": {
    "issues": "https://gitlab.com/sanjay_nitsan/ns_basetheme/issues"
  },
  "license": "MIT",
  "require": {
    "typo3/cms-core": ">=8.0.0",
    "georgringer/news": ">=4.3.0",
    "gridelementsteam/gridelements": ">=8.0.0"
  },
  "autoload": {
    "psr-4": {
      "NITSAN\\ns_basetheme\\": "Classes/"
    }
  },
  "replace": {
      "ns_basetheme": "self.version",
      "nitsan/ns-basetheme": "self.version"
  },
  "config": {
    "vendor-dir": ".Build/vendor/",
    "bin-dir": ".Build/bin/"
  },
  "extra": {
      "typo3/cms": {
          "cms-package-dir": "{$vendor-dir}/typo3/cms",
          "web-dir": ".Build/public",
          "extension-key": "ns_basetheme"
      }
  }
}