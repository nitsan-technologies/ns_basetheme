// Backend Layout for "Default" Template
mod {
    web_layout {
        BackendLayouts {
            default {
                title = ns_basetheme.backend_layouts.messages:default
                icon = EXT:ns_basetheme/Resources/Public/Icons/BackendLayouts/default.gif
                config {
                    backend_layout {
                        colCount = 1
                        rowCount = 2
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = ns_basetheme.backend_layouts.messages:content
                                        colPos = 0
                                    }
                                }
                            }

                            2 {
                                columns {
                                    1 {
                                        name = ns_basetheme.backend_layouts.messages:footer
                                        colPos = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
