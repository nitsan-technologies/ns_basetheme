config {

    # Global common configuration
    doctype = html5
    xmlprologue = none
    linkVars = L
    uniqueLinkVars = 0
    admPanel = 0
    extTarget = _blank
    fileTarget = _blank

    # Mail Spamming Security
    spamProtectEmailAddresses = ascii

    # For Caching
    cache_period = 86400
    no_cache = {$ns_basetheme.website.settings.no_cache}

    # For Debugging
    contentObjectExceptionHandler = 0

    # Add header comment
    headerComment (

    )

    # For TYPO3 v9 EXT:realurl
    # tx_realurl_enable = 1

    # For enable indexed search
    index_enable = 1

    # index files
    index_externals = 1

    # don't index metatags
    index_metatags = 0

    # Site Optimization
    # Note: config.compress*/concatenate* were removed in TYPO3 v14 (Breaking #108055).
    # Optional AssetCollector minify is gated via Extension Settings (assetCollector.*), default off.
    moveJsFromHeaderToFooter = 1
}

# for TYPO3 v8, Mulit-Langauge configuration
/*
[globalVar = GP:L = 1]
    config {
        htmlTag_langKey = en
        sys_language_uid = 1
        language = en
        locale_all = en_EN
    }
[global]
*/
